# Copy to .env.local and fill in. Never commit .env.local.

# --- Telegram bot ---
# From BotFather. Used server-side only to verify initData HMAC.
TELEGRAM_BOT_TOKEN=

# --- Supabase ---
# Public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only mirror (some serverless runtimes don't ship NEXT_PUBLIC_*).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Tunables ---
# How old (in seconds) a Telegram auth_date is allowed to be. Default 24h.
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# --- Admin endpoint ---
# Long random string. Required to call /api/v1/admin/data/* (catalog inspector).
ADMIN_API_KEY=

# --- Cloudflare R2 (asset storage; S3-compatible API) ---
R2_ACCOUNT_ID=
R2_BUCKET=abyss-assets
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public read URL of the bucket. Either pub-xxx.r2.dev or your custom domain.
R2_PUBLIC_BASE_URL=

# --- PixelLab (art generation; HTTP API for scripts; MCP for dev-time) ---
PIXELLAB_API_KEY=
